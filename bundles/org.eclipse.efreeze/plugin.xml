<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.startup">
      <startup
            class="org.eclipse.efreeze.Startup">
      </startup>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            class="org.eclipse.efreeze.ui.PreferencePage"
            id="org.eclipse.efreeze.PreferencePage"
            name="EFreeze">
      </page>
   </extension>
   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="org.eclipse.efreeze.PreferenceInitializer">
      </initializer>
   </extension>

</plugin>
